{
	"name": "@workspace/shared",
	"version": "1.0.0",
	"sideEffects": false,
	"private": true,
	"imports": {
		"#*": [
			"./src/*.ts",
			"./src/*.tsx"
		]
	},
	"exports": {
		"./hooks/*": "./src/hooks/*.ts",
		"./types/*": "./src/types/*.ts",
		"./schema/*": "./src/schema/*.ts",
		"./utils/*": "./src/utils/*.ts",
		"./server_bridge": "./src/server_bridge.ts"
	},
	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@workspace/server": "workspace:*",
		"zod": "^3.25.67"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.79.2",
		"react": "19.2.8"
	},
	"devDependencies": {
		"@tanstack/eslint-plugin-query": "^5.64.2",
		"@tanstack/react-query": "5.79.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.15.0",
		"react": "19.2.8",
		"typescript": "5.8.3"
	}
}
